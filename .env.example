# Copy to .env and adjust. Nothing here is secret; .env itself is git-ignored.
# Load it with: uv run --env-file .env <command>

# Root folder for raw and intermediate data (git-ignored).
FLIGHT_DELAYS_DATA_DIR=data

# DuckDB database file used by dbt and the Python package.
FLIGHT_DELAYS_DUCKDB_PATH=data/flight_delays.duckdb

# Folder the Brazil VRA research scripts read from and download.py writes to.
BRAZIL_VRA_DATA_DIR=data/research/brazil_vra
